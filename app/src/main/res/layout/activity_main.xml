<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <EditText
        android:id="@+id/etIdentificador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Identificador del Uruk-hai"
        android:inputType="text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Spinner Tipo Unidad -->
    <Spinner
        android:id="@+id/spinnerTipo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:entries="@array/tipos_unidad"
        android:minHeight="48dp"
        app:layout_constraintTop_toBottomOf="@id/etIdentificador"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- RadioGroup Equipamiento -->
    <RadioGroup
        android:id="@+id/rgEquipamiento"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/spinnerTipo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:checkedButton="@+id/rbArmadura">

        <RadioButton
            android:id="@+id/rbArmadura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Armadura de Hierro" />

        <RadioButton
            android:id="@+id/rbEscudo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escudo de Isengard" />
    </RadioGroup>

    <!-- CheckBox Antorcha -->
    <CheckBox
        android:id="@+id/cbAntorcha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Llevar Antorcha de Polvorín"
        app:layout_constraintTop_toBottomOf="@id/rgEquipamiento"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"/>

    <!-- ImageButton Enviar  -->
    <ImageButton
        android:id="@+id/btnEnviar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_menu_send"
        android:contentDescription="Enviar a la batalla"
        android:padding="16dp"
        android:backgroundTint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>